<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        BUG FIX 34: Load CSS for frontend editor launcher (internal users only)

        NOTE: Only inject CSS for INTERNAL users (users with backend access)
        Portal users should NOT have custom color styling per user requirement.

        Check: request.env.user.has_group('base.group_user') = internal user
        Portal users have 'base.group_portal' but NOT 'base.group_user'

        Cache busting: Include color value in URL so browser fetches fresh CSS
        when color changes (no force refresh needed).
    -->
    <template id="color_customizer_frontend_css" name="Color Customizer Frontend CSS"
              inherit_id="website.layout" priority="100">
        <xpath expr="//head/link[last()]" position="after">
            <!-- Only load for internal users (not portal users) -->
            <t t-if="request.env.user.has_group('base.group_user')">
                <t t-set="primary_color" t-value="request.env['ir.config_parameter'].sudo().get_param('odoo_color_customizer.primary_color', '#71639e')"/>
                <!-- PWA theme-color for mobile browsers and PWA title bar -->
                <meta name="theme-color" t-att-content="primary_color or '#71639e'"/>
                <!-- Apple PWA status bar color -->
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <!-- Load frontend CSS (for internal users only) -->
                <link rel="stylesheet" type="text/css"
                      t-attf-href="/color_customizer/frontend.css?v={{ primary_color[1:] if primary_color else '71639e' }}"/>
            </t>
        </xpath>
    </template>

    <!--
        REMOVED: web.frontend_layout injection (BUG FIX 37)
        Portal user pages should NOT have custom color styling per user requirement.
    -->
</odoo>
