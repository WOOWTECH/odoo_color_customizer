<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        BUG FIX 34: Load minimal CSS for frontend editor launcher
        This template adds ONLY the CSS needed for the triangle/square fix.
        Other frontend elements remain unchanged.

        Cache busting: Include color value in URL so browser fetches fresh CSS
        when color changes (no force refresh needed).
    -->
    <template id="color_customizer_frontend_css" name="Color Customizer Frontend CSS"
              inherit_id="website.layout" priority="100">
        <xpath expr="//head/link[last()]" position="after">
            <t t-set="primary_color" t-value="request.env['ir.config_parameter'].sudo().get_param('odoo_color_customizer.primary_color', '#71639e')"/>
            <link rel="stylesheet" type="text/css"
                  t-attf-href="/color_customizer/frontend.css?v={{ primary_color[1:] if primary_color else '71639e' }}"/>
        </xpath>
    </template>
</odoo>
